# Use only the NEW Sports Management Platform Supabase database.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3500/auth/google/callback
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3500
RESEND_API_KEY=
INVITE_FROM_EMAIL=Interclub Snooker <noreply@interclubsnooker.com>

# Scheduled reminder processing (same secret used by existing app cron routes)
CRON_SECRET=
# Optional Web Push: generate once with pnpm exec web-push generate-vapid-keys
# Never expose the private key to the client or regenerate keys on each deploy.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com

# Golf Ireland: demo uses labelled sample data; live requires club-issued ISV access.
# Never use NEXT_PUBLIC_ variables for these secrets or member mappings.
GOLF_IRELAND_DATA_MODE=demo
# JSON keyed by local club UUID: {"club-uuid":{"username":"...","secretKey":"..."}}
GOLF_IRELAND_CLUB_CREDENTIALS={}
# JSON keyed by local club UUID, then Golf Ireland number -> API member UUID.
GOLF_IRELAND_MEMBER_UIDS={}
